{
  "name": "easypage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "易页 EasyPage · 可视化 HTML 精修编辑器（P0 纯本地）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "vite build --config vite.extension.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts --configLoader runner && node scripts/package-embed-snippet.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:licenses",
    "qa:metrics": "node qa/metrics/run-metrics.mjs",
    "qa:metrics:update-baseline": "node qa/metrics/run-metrics.mjs --update-baseline",
    "qa:g1": "npm run build:extension && node qa/probes/p0-9-manual-copy-save.mjs",
    "qa:selfcontain": "node qa/probes/selfcontain-capability.mjs",
    "qa:download": "node qa/probes/download-write-capability.mjs"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "parse5": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "happy-dom": "^15.11.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
